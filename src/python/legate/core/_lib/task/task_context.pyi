from ..data.physical_store import PhysicalStore
from ..data.scalar import Scalar
from ..geometry import Point, Rect
from ..mapping.machine import Machine
from ..utilities.typedefs import VariantCode
from ..utilities.unconstructable import Unconstructable

class TaskContext(Unconstructable):
    def get_variant_kind(self) -> VariantCode: ...
    @property
    def inputs(self) -> tuple[PhysicalStore, ...]: ...
    @property
    def outputs(self) -> tuple[PhysicalStore, ...]: ...
    @property
    def reductions(self) -> tuple[PhysicalStore, ...]: ...
    @property
    def scalars(self) -> tuple[Scalar, ...]: ...
    def is_single_task(self) -> bool: ...
    @property
    def task_index(self) -> Point: ...
    @property
    def launch_domain(self) -> Rect: ...
    @property
    def machine(self) -> Machine: ...
    @property
    def provenance(self) -> str: ...
    @property
    def task_stream(self) -> int | None: ...
    def can_raise_exception(self) -> bool: ...
